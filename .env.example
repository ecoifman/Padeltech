# Required to open /admin. Leave empty locally only if you do not need the inbox.
ADMIN_PASSWORD=

# Optional live booking system. When set, BOOK A COURT goes there.
NEXT_PUBLIC_BOOKING_URL=

# Public site URL, used for share images and canonical links (e.g. https://padeltech.co.il).
NEXT_PUBLIC_SITE_URL=

# Public contact email, shown on the contact page, in the footer and on /privacy.
NEXT_PUBLIC_CONTACT_EMAIL=

# Address shown on /privacy for data requests. Without it, the page points to the site forms.
NEXT_PUBLIC_PRIVACY_EMAIL=

# Phone shown on the site, with a WhatsApp link (e.g. 050-123-4567). Hidden when empty.
NEXT_PUBLIC_CONTACT_PHONE=

# Every form submission is also POSTed here as JSON (e.g. a Google Apps Script web app
# that adds a row to a sheet and emails you). Required on hosts without a writable disk.
LEAD_WEBHOOK_URL=
